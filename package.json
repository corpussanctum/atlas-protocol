{
  "name": "atlas-protocol",
  "version": "1.0.5",
  "description": "Enterprise-grade security governance for autonomous AI agents. Identity attestation, post-quantum audit trails, and human oversight.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atlas-protocol": "dist/index.js",
    "atlas-operator": "dist/operator-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.tests.json",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build:test && node --test .test-dist/tests/*.test.js",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "keywords": [
    "claude-code",
    "channels",
    "mcp",
    "security",
    "governance",
    "audit",
    "enterprise",
    "compliance",
    "post-quantum",
    "identity",
    "telegram",
    "permission-relay"
  ],
  "author": "TJ Lane <tj@corpussanctum.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/corpussanctum/atlas-protocol.git"
  },
  "homepage": "https://github.com/corpussanctum/atlas-protocol#readme",
  "bugs": {
    "url": "https://github.com/corpussanctum/atlas-protocol/issues"
  },
  "files": [
    "dist/",
    ".claude-plugin/",
    "sample-briefcase/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@noble/post-quantum": "^0.2.0",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "serialport": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "serialport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

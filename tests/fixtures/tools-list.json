      "destructiveHint": true
    }
  },
  {
    "name": "atlas_identity_delegate",
    "description": "Delegate a scoped sub-credential from a parent agent. Child capabilities must be a subset of parent's. Max depth: 3.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "parent_agent_id": {
          "type": "string",
          "description": "Parent did:atlas:<uuid>"
        },
        "child_name": {
          "type": "string",
          "description": "Child agent display name"
        },
        "child_role": {
          "type": "string",
          "enum": [
            "claude-code",
            "orchestrator",
            "tool-caller",
            "observer",
            "admin"
          ],
          "description": "Child agent role"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "file:read",
              "file:write",
              "file:delete",
              "shell:exec",
              "shell:read",
              "network:outbound",
              "network:inbound",
              "process:spawn",
              "process:kill",
              "credential:read",
              "audit:read",
              "identity:register",
              "identity:revoke"
            ]
          },
          "description": "Capabilities (must be subset of parent)"
        },
        "ttl_hours": {
          "type": "number",
          "description": "TTL in hours (capped at parent remaining)"
        }
      },
      "required": [
        "parent_agent_id",
        "child_name",
        "child_role",
        "capabilities"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },

# Atlas Protocol gatekeeper settings (separate-user deployment).
# Owned root:atlas, mode 0640. The agent user cannot read this file.
# Sourced by /bin/sh: one KEY=value per line, quote values with spaces.
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_IDS=
ATLAS_HMAC_SECRET=
ATLAS_KEYSTORE_PASSPHRASE=
ATLAS_OPERATOR_KEY_ID=
# Refuse to start unless the isolation self-check passes
ATLAS_REQUIRE_ISOLATION=true
